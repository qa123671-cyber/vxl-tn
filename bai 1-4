
.INCLUDE "m324pdef.inc"

.ORG 0x0000
    RJMP RESET

RESET:
    ; Khoi tao Stack Pointer
    LDI R16, HIGH(RAMEND)
    OUT SPH, R16
    LDI R16, LOW(RAMEND)
    OUT SPL, R16

    ; PORTA: INPUT
    LDI R16, 0x00
    OUT DDRA, R16

    ; Kich hoat Pull-up PORTA
    LDI R16, 0xFF
    OUT PORTA, R16

    ; PORTB: OUTPUT
    LDI R16, 0xFF
    OUT DDRB, R16

MAIN:
    ; Doc gia tri PORTA
    IN R16, PINA

    ; Tach nibble cao
    MOV R17, R16
    SWAP R17
    ANDI R17, 0x0F

    ; Tach nibble thap
    ANDI R16, 0x0F

    ; Mo rong dau nibble cao
    SBRC R17, 3
    ORI R17, 0xF0

    ; Mo rong dau nibble thap
    SBRC R16, 3
    ORI R16, 0xF0

    ; Nhan hai so co dau
    MULS R17, R16

    ; Xuat ket qua ra PORTB
    OUT PORTB, R0

    RJMP MAIN

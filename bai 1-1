.INCLUDE "m324pdef.inc"

.ORG 0x0000
    RJMP RESET

RESET:
    ; Khoi tao Stack Pointer
    LDI R16, HIGH(RAMEND)
    OUT SPH, R16
    LDI R16, LOW(RAMEND)
    OUT SPL, R16

    ; Cau hinh PORTA la INPUT
    LDI R16, 0x00
    OUT DDRA, R16

    ; Kich hoat Pull-up PORTA
    LDI R16, 0xFF
    OUT PORTA, R16

    ; Cau hinh PORTB la OUTPUT
    LDI R16, 0xFF
    OUT DDRB, R16

MAIN:
    ; Doc trang thai DIP Switch
    IN R16, PINA

    ; Dao bit de LED sang khi Switch ON
    COM R16

    ; Xuat ra LED Bar
    OUT PORTB, R16

    RJMP MAIN
